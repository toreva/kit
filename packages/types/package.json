{
  "name": "@toreva/types",
  "version": "0.3.0",
  "description": "Connector primitives for Toreva governed objects. Bring your own compute, use the gateway relay, and require receipts for every outcome.",
  "keywords": [
    "gateway", "governed-objects", "receipts", "relay",
    "compute-binding", "typescript", "types"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/toreva/kit"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./statement-of-intent": {
      "types": "./dist/statement-of-intent.d.ts",
      "import": "./dist/statement-of-intent.js"
    },
    "./intent-box": {
      "types": "./dist/intent-box.d.ts",
      "import": "./dist/intent-box.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
