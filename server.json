{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.toreva/kit",
  "description": "Toreva Help for developers, v0.2.1: connect MCP clients to Toreva, with receipts.",
  "repository": {
    "url": "https://github.com/toreva/kit",
    "source": "github"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@toreva/mcp",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/toreva/kit/main/assets/brand/toro-head-mark-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ]
}
